# Copy to .env (never commit it). Loaded by `tradebot` at startup.
# AI models run through your Claude subscription (`claude` CLI login) by default: no Anthropic key needed.
# Only set this if you switch config llm.backend to "api" (pay per token). It is never passed to the CLI.
ANTHROPIC_API_KEY=
# Discord alerts: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional news sources (leave empty to disable)
# X API pay-per-use (~$0.005/post read), capped by news.x_max_posts_per_day in config/settings.yaml
X_BEARER_TOKEN=
CRYPTOPANIC_TOKEN=
# Live trading is refused unless this is set exactly AND the paper-trading gate has passed.
# TRADEBOT_ALLOW_LIVE=I_UNDERSTAND_THIS_USES_REAL_MONEY
